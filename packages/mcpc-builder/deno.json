{
  "name": "@mcpc/builder",
  "version": "0.0.26",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcpc-tech/mcpc.git"
  },
  "exports": {
    ".": "./mod.ts",
    "./agent": "./mcpc-builder-agent.ts"
  },
  "bin": {
    "mcpc-builder-agent": "./mcpc-builder-agent.ts"
  },
  "publish": {
    "include": [
      "*.ts",
      "src/**/*.ts",
      "agents/**/*.md"
    ]
  },
  "imports": {
    "@mcpc/core": "jsr:@mcpc/core@^0.3.39",
    "@mcpc/plugin-markdown-loader": "jsr:@mcpc/plugin-markdown-loader@^0.0.12",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.8.0",
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "zod": "npm:zod@^3.24.2"
  },
  "tasks": {
    "dev": "deno run --allow-all --watch src/bin.ts",
    "start": "deno run --allow-all src/bin.ts"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.ns"
    ]
  }
}
