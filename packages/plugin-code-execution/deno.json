{
  "name": "@mcpc/plugin-code-execution",
  "version": "0.0.21",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcpc-tech/mcpc.git"
  },
  "exports": {
    ".": "./mod.ts",
    "./plugin": "./src/plugin.ts",
    "./sandbox": "./src/sandbox-executor.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.8.0",
    "@mcpc/core": "jsr:@mcpc/core@^0.3.34",
    "@mcpc/utils": "jsr:@mcpc/utils@^0.2.11",
    "@mcpc-tech/handle-sandbox": "npm:@mcpc-tech/handle-sandbox@^0.0.8"
  },
  "publish": {
    "exclude": [
      "examples/**",
      "tests/**",
      "logs/**"
    ]
  },
  "tasks": {
    "dev": "deno run --allow-all examples/basic-usage.ts",
    "test": "deno test --allow-all tests/"
  }
}
