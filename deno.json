{
  "vendor": true,
  "nodeModulesDir": "auto",
  "tasks": {
    "precommit": "deno lint && deno check && deno fmt",
    "test": "deno test --allow-all packages/*/tests/",
    "build": "deno check packages/*/mod.ts",
    "version": "deno run --allow-read --allow-write scripts/version.ts"
  },
  "workspace": [
    "./packages/utils",
    "./packages/core",
    "./packages/cli",
    "./packages/mcp-sampling-ai-provider",
    "./packages/acp-ai-provider",
    "./packages/mcpc-builder",
    "./packages/plugin-code-execution",
    "./packages/plugin-code-execution-sampling",
    "./packages/plugin-markdown-loader"
  ],
  "imports": {
    "@mcpc/utils": "./packages/utils/mod.ts",
    "@mcpc/core": "./packages/core/mod.ts",
    "@mcpc/cli": "./packages/cli/mod.ts",
    "@mcpc/acp-ai-provider": "./packages/acp-ai-provider/mod.ts",
    "@mcpc/mcp-sampling-ai-provider": "./packages/mcp-sampling-ai-provider/mod.ts",
    "@mcpc/builder": "./packages/mcpc-builder/mod.ts",
    "@mcpc/plugin-code-execution": "./packages/plugin-code-execution/mod.ts",
    "@mcpc/plugin-code-execution/sandbox": "./packages/plugin-code-execution/src/sandbox-executor.ts",
    "@mcpc/plugin-code-execution-sampling": "./packages/plugin-code-execution-sampling/mod.ts",
    "@mcpc/plugin-markdown-loader": "./packages/plugin-markdown-loader/mod.ts",
    "@es-toolkit/es-toolkit": "jsr:@es-toolkit/es-toolkit@^1.37.2",
    "json-schema-faker": "npm:json-schema-faker@^0.5.9",
    "json-schema-traverse": "npm:json-schema-traverse@^1.0.0",
    "zod": "npm:zod@^3.23.8"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  }
}
